@startuml
!include style.puml
skinparam ArrowFontStyle plain

box Logic LOGIC_COLOR_T1
participant ":LogicManager" as LogicManager LOGIC_COLOR
participant ":AddressBookParser" as AddressBookParser LOGIC_COLOR
participant ":DeleteCommandParser" as DeleteCommandParser LOGIC_COLOR
participant "d:DeleteByIndexCommand" as DeleteByIndexCommand LOGIC_COLOR
participant "r:CommandResult" as CommandResult LOGIC_COLOR
end box

box Model MODEL_COLOR_T1
participant "m:Model" as Model MODEL_COLOR
end box

box Storage STORAGE_COLOR_T1
participant "s:Storage" as Storage STORAGE_COLOR
end box

[-> LogicManager : execute("delete 1")
activate LogicManager

LogicManager -> AddressBookParser : parseCommand("delete 1")
activate AddressBookParser

AddressBookParser -> DeleteCommandParser : parse("1")
activate DeleteCommandParser

create DeleteByIndexCommand
DeleteCommandParser -> DeleteByIndexCommand : DeleteByIndexCommand(index)
activate DeleteByIndexCommand

DeleteByIndexCommand --> DeleteCommandParser :
deactivate DeleteByIndexCommand

DeleteCommandParser --> AddressBookParser : d
deactivate DeleteCommandParser

AddressBookParser --> LogicManager : d
deactivate AddressBookParser

LogicManager -> DeleteByIndexCommand : execute(m)
activate DeleteByIndexCommand

DeleteByIndexCommand -> Model : getFilteredPersonList()
activate Model

Model --> DeleteByIndexCommand : shownPersons
deactivate Model

DeleteByIndexCommand -> Model : deletePerson(p)
activate Model

Model --> DeleteByIndexCommand
deactivate Model

create CommandResult
DeleteByIndexCommand -> CommandResult
activate CommandResult

CommandResult --> DeleteByIndexCommand
deactivate CommandResult

DeleteByIndexCommand --> LogicManager : r
deactivate DeleteByIndexCommand

LogicManager -> Storage : saveAddressBook(addressBook)
activate Storage

Storage --> LogicManager
deactivate Storage

[<--LogicManager
deactivate LogicManager
@enduml
