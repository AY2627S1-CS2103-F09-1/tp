@startuml
!include style.puml
skinparam arrowThickness 1.1
skinparam arrowColor LOGIC_COLOR_T4
skinparam classBackgroundColor LOGIC_COLOR

Class "{abstract}\nCommand" as Command

Class "{abstract}\nXYZCommand" as XYZCommand
Class XYZByIndexCommand
Class XYZByNameAndClassCommand

Class "{abstract}\nGroupMembershipCommand" as GroupMembershipCommand
Class TagCommand
Class UntagCommand

XYZCommand -up-|> Command
XYZByIndexCommand -up-|> XYZCommand
XYZByNameAndClassCommand -up-|> XYZCommand

GroupMembershipCommand -up-|> Command
TagCommand -up-|> GroupMembershipCommand
UntagCommand -up-|> GroupMembershipCommand

note right of Command
  AddCommand, EditCommand, ListCommand,
  ImportCommand, ClearCommand, HelpCommand,
  ExitCommand, ViewAttendanceCommand and
  ViewGradeCommand extend Command directly
end note

note right of XYZCommand
  XYZ = Delete, DeleteAttendance,
  DeleteGrade, Attendance, Grade
end note
@enduml
